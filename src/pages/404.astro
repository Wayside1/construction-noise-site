---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="The page you were looking for could not be found." noindex>
  <div class="wrap" style="padding:80px 22px;text-align:center">
    <h1>Page not found</h1>
    <p class="lede" style="margin:0 auto 24px">That page has moved or no longer exists.</p>
    <a class="btn" href="/">Go to the home page</a> &nbsp; <a class="btn ghost" href="/news">Browse articles</a>
  </div>
</Base>
