---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { learningArticles, publishedArticles } from '../data/content';
import { CATEGORIES } from '../data/site';
const lib = await learningArticles();
const articles = await publishedArticles();
const filters: [string, string][] = [['explainer', 'Explainers'], ...Object.entries(CATEGORIES)];
---
<Base title="Construction Noise Explained: Guides, News, dB, Rw & BS 5228" description="The construction acoustics library: plain-English explainers on the law, BS 5228, decibels and Rw ratings, plus news, in-depth guides and honest comparisons of noise control options.">
  <PageHead eyebrow="Learning Centre" title="Construction acoustics, explained" lede="Everything to do with construction noise in one place: what the law says, how noise is measured and rated, real cases from around the UK, and what actually reduces it. Written for residents and contractors alike." />
  <div class="wrap block">
    <div class="chips" role="group" aria-label="Filter by type">
      <button aria-pressed="true" data-f="all">All</button>
      {filters.map(([k, v]) => <button aria-pressed="false" data-f={k}>{v}</button>)}
    </div>
    <div class="grid g3" id="list">
      {articles.map((a) => <ArticleCard a={a} />)}
      {lib.map((a) => (
        <a class="card" href={`/learning-centre/${a.id}`} data-cat="explainer">
          <div style="display:flex;justify-content:space-between;gap:8px;align-items:center;margin-bottom:10px"><span class="tag">Explainer · {a.data.category}</span><span class="meta">{a.data.readTime}</span></div>
          <h3>{a.data.title}</h3>
          <p>{a.data.summary}</p>
          <span class="more">Read →</span>
        </a>
      ))}
    </div>
  </div>
  <script is:inline>
    var params = new URLSearchParams(location.search);
    function apply(f){
      document.querySelectorAll('.chips button').forEach(function(x){ x.setAttribute('aria-pressed', x.dataset.f === f); });
      document.querySelectorAll('#list .card').forEach(function(c){ c.style.display = (f === 'all' || c.dataset.cat === f) ? '' : 'none'; });
    }
    document.querySelectorAll('.chips button').forEach(function(b){ b.addEventListener('click', function(){ apply(b.dataset.f); }); });
    if (params.get('type')) apply(params.get('type'));
  </script>
</Base>
